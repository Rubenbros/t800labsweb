# Copia este fichero a .env.local y rellena los valores.
# NUNCA commitees .env.local ni ningún fichero con secretos.

# ── Base de datos (Cloud SQL, PostgreSQL) ──────────────────────────────────
# Local, a través del Cloud SQL Auth Proxy (127.0.0.1:5433):
DATABASE_URL="postgresql://t800labsweb_app:PASSWORD@127.0.0.1:5433/t800labsweb"
# En Cloud Run se inyecta desde Secret Manager con socket unix:
# postgresql://t800labsweb_app:PASSWORD@localhost/t800labsweb?host=/cloudsql/t800labsweb:europe-west1:t800labs-pg
#
# Sin DATABASE_URL la web sigue funcionando: las estadísticas de HAL usan un
# fallback determinista y las demos dinámicas quedan deshabilitadas.

# Base de datos para el test de integración (tests/db.integration.test.ts).
# Si no está definida, ese test se salta.
DATABASE_URL_TEST="postgresql://t800labsweb_app:PASSWORD@127.0.0.1:5433/t800labsweb"

# ── Correo (API de Gmail, Google Workspace) ────────────────────────────────
MAILER_SERVICE_ACCOUNT="mailer@t800labsweb.iam.gserviceaccount.com"
GMAIL_SENDER="admin@t800labs.com"
MAIL_FROM="T800 Labs <admin@t800labs.com>"
CONTACT_TO="admin@t800labs.com"
# "console" imprime el correo en vez de enviarlo (desarrollo y tests).
MAIL_TRANSPORT="console"

# ── API de registro de demos (Lead Hunter) ─────────────────────────────────
DEMO_API_KEY="cambia-esto"

# ── Solo para la migración puntual desde Upstash ───────────────────────────
# scripts/migrate-upstash-to-pg.mjs
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
